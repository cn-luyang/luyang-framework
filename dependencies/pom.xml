<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.cn-luyang</groupId>
    <artifactId>dependencies</artifactId>
    <version>${revision}</version>
    <name>Dependencies</name>

    <packaging>pom</packaging>

    <!-- 项目描述 -->
    <description>luyang framework bom</description>

    <!-- 项目主页 -->
    <url>https://github.com/cn-luyang/luyang-framework</url>

    <!-- 开源协议信息 -->
    <licenses>
        <license>
            <name>Apache License Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <!-- Git 仓库信息 -->
    <scm>
        <url>https://github.com/cn-luyang/luyang-framework</url>
        <connection>scm:git:https://github.com/cn-luyang/luyang-framework.git</connection>
        <developerConnection>scm:git:https://github.com/cn-luyang/luyang-framework.git</developerConnection>
        <tag>HEAD</tag>
    </scm>

    <!-- 开发者信息 -->
    <developers>
        <developer>
            <name>luyang</name>
            <email>cn_luyang@163.com</email>
        </developer>
    </developers>

    <!-- 发布配置：快照与正式版本分别上传至 OSSRH -->
    <distributionManagement>
        <snapshotRepository>
            <id>ossrh</id>
            <url>https://s01.oss.sonatype.org/content/repositories/snapshots</url>
        </snapshotRepository>
        <repository>
            <id>ossrh</id>
            <url>https://s01.oss.sonatype.org/service/local/staging/deploy/maven2/</url>
        </repository>
    </distributionManagement>
    <properties>
        <revision>0.0.19-SNAPSH0T</revision>
        <!-- SpringBoot SpringCloud SpringCloudAlibaba 版本 https://sca.aliyun.com/docs/2023/overview/version-explain/?spm=5176.29160081.0.0.511d1d28E6mG9S -->
        <spring-boot-dependencies.version>3.5.0</spring-boot-dependencies.version>
        <spring-cloud-dependencies.version>2025.0.0</spring-cloud-dependencies.version>
        <!-- Nacos官网 https://nacos.io/?spm=5238cd80.5e8a737d.0.0.3e5d7e84StoDVK -->
        <spring-cloud-alibaba-dependencies.version>2023.0.3.3</spring-cloud-alibaba-dependencies.version>

        <!-- Dubbo官网 https://cn.dubbo.apache.org/zh-cn/ -->
        <dubbo-bom.version>3.3.4</dubbo-bom.version>
        <!-- MyBatis-Plus官网 https://www.baomidou.com/ -->
        <mybatis-plus-bom.version>3.5.12</mybatis-plus-bom.version>

        <redisson-spring-boot-starter.version>3.45.1</redisson-spring-boot-starter.version>

        <mapstruct.version>1.6.3</mapstruct.version>
        <!-- Hutool官网 https://hutool.cn/ -->
        <hutool-all.version>5.8.39</hutool-all.version>
        <mysql-connector-java.version>8.0.33</mysql-connector-java.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot 基础依赖管理 -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot-dependencies.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring Boot Web Starter（移除默认的 Tomcat） -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-web</artifactId>
                <version>${spring-boot-dependencies.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-starter-tomcat</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud-dependencies.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba-dependencies.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.apache.dubbo</groupId>
                <artifactId>dubbo-bom</artifactId>
                <version>${dubbo-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-bom</artifactId>
                <version>${mybatis-plus-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson-spring-boot-starter</artifactId>
                <version>${redisson-spring-boot-starter.version}</version>
            </dependency>

            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-core</artifactId>
                <version>${hutool-all.version}</version>
            </dependency>
            <!-- MapStruct -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <!-- MapStruct 编译处理器 -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <!-- Lombok 和 MapStruct 集成 -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok-mapstruct-binding</artifactId>
                <version>${lombok-mapstruct-binding.version}</version>
            </dependency>
            <dependency>
                <groupId>mysql</groupId>
                <artifactId>mysql-connector-java</artifactId>
                <version>${mysql-connector-java.version}</version>
            </dependency>

            <dependency>
                <groupId>io.github.cn-luyang</groupId>
                <artifactId>luyang-framework-starter-base</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.cn-luyang</groupId>
                <artifactId>luyang-framework-starter-dict</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.cn-luyang</groupId>
                <artifactId>luyang-framework-starter-dubbo</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.cn-luyang</groupId>
                <artifactId>luyang-framework-starter-mybatis</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.cn-luyang</groupId>
                <artifactId>luyang-framework-starter-redisson</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.cn-luyang</groupId>
                <artifactId>luyang-framework-starter-security</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.cn-luyang</groupId>
                <artifactId>luyang-framework-starter-web</artifactId>
                <version>${revision}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- 打包源码插件：生成 source.jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <!-- 目标任务：生成 source.jar -->
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- 打包文档插件：生成 javadoc.jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.11.2</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <!-- 目标任务：生成 javadoc.jar -->
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <!-- Java 文件读取编码 -->
                    <charset>UTF-8</charset>
                    <!-- Java 源文件的编码方式 -->
                    <encoding>UTF-8</encoding>
                    <!-- Javadoc 输出文档编码 -->
                    <docencoding>UTF-8</docencoding>
                    <!-- 是否在遇到错误时终止构建，false 表示忽略错误 -->
                    <failOnError>false</failOnError>
                    <additionalOptions>
                        <!-- 禁用 Javadoc 严格校验，避免 Java 8+ 下报错 -->
                        <additionalOption>-Xdoclint:none</additionalOption>
                    </additionalOptions>
                </configuration>
            </plugin>

            <!-- GPG 签名插件：对构件进行签名，发布中央仓库所需 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
                <version>3.2.7</version>
                <executions>
                    <execution>
                        <id>sign-artifacts</id>
                        <!-- 绑定到 verify 阶段执行签名 -->
                        <phase>verify</phase>
                        <goals>
                            <!-- 执行签名目标 -->
                            <goal>sign</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Sonatype 中央仓库发布插件：简化发布流程 -->
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>0.7.0</version>
                <!-- 标记为构建扩展，自动激活 -->
                <extensions>true</extensions>
                <configuration>
                    <!-- 发布服务器 ID，需与 Maven settings.xml 配置文件中的 ID 对应 -->
                    <publishingServerId>central</publishingServerId>
                    <!-- 自动发布，无需手动关闭 staging -->
                    <autoPublish>true</autoPublish>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
